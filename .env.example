# Netatmo Weather MCP Configuration
# Copy this file to .env and fill in your values

# Required: Netatmo API Credentials
# Get these from https://dev.netatmo.com/
NETATMO_CLIENT_ID=your_client_id_here
NETATMO_CLIENT_SECRET=your_client_secret_here
NETATMO_USERNAME=your_netatmo_email@example.com
NETATMO_PASSWORD=your_netatmo_password

# Optional: API Scope (default: read_station)
NETATMO_SCOPE=read_station

# Optional: Monitoring Configuration
METRICS_PORT=9091
ENABLE_METRICS=true

# Optional: Logging Configuration
LOG_LEVEL=INFO

# Optional: Server Configuration
HOST=localhost
PORT=10823

# Optional: Development Settings
DEBUG=false
TEST_MODE=false

# Optional: AI Configuration
SAMPLING_ITERATIONS_DEFAULT=5
PREDICTION_CONFIDENCE_THRESHOLD=0.8
MAX_FORECAST_HOURS=168

# Optional: Caching Configuration
CACHE_TTL_SECONDS=300
ENABLE_CACHE=true

# Optional: Rate Limiting
API_RATE_LIMIT_REQUESTS_PER_MINUTE=30
API_RATE_LIMIT_BURST_SIZE=10

# Optional: Data Processing
DATA_RETENTION_DAYS=30
COMPRESSION_ENABLED=true

# Optional: External Services
# Prometheus metrics endpoint (if different from localhost)
PROMETHEUS_PUSHGATEWAY_URL=
# Loki log aggregation endpoint
LOKI_URL=http://localhost:3100